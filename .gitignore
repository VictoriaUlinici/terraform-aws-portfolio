# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Real variable files (use the committed *.tfvars.example as a template instead)
*.tfvars
!*.tfvars.example

# Plan output
*.tfplan

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

.vscode/
.claude
.gitignore
