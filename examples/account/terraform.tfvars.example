# Copy to terraform.tfvars and adjust to your own account before running terraform apply.

aws_region  = "eu-west-1"
aws_profile = "my-aws-profile"

kms_key_arn = "arn:aws:kms:eu-west-1:123456789012:key/00000000-0000-0000-0000-000000000000"

secret_arns = [
  "arn:aws:secretsmanager:eu-west-1:123456789012:secret:bootstrap/ec2-XXXXXX"
]

event_bus_arns = [
  "arn:aws:events:eu-west-1:123456789012:event-bus/provisioning"
]

instances = {
  "web-01" = {
    ami                 = "ami-0123456789abcdef0"
    instance_type       = "t3.small"
    subnet_id           = "subnet-0123456789abcdef0"
    security_group_ids  = ["sg-0123456789abcdef0"]
    os_family           = "linux"
    key_name            = "my-key-pair"
    root_volume_size    = 30
    additional_disks    = [20]
  }
}

buckets = {
  "my-app-assets" = {
    enable_versioning = true
    create_iam_user   = true
  }
}
