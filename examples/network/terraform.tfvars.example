# Copy to terraform.tfvars and adjust to your own account before running terraform apply.

aws_region  = "eu-west-1"
aws_profile = "my-aws-profile"

vpc_id = "vpc-0123456789abcdef0"

listener_arns = {
  "443" = "arn:aws:elasticloadbalancing:eu-west-1:123456789012:listener/app/my-alb/xxxxxxxxxxxxxxxx/xxxxxxxxxxxxxxxx"
}

internal_security_group_id = "sg-0123456789abcdef0"

services = {
  "example-service" = {
    listener_port        = 443
    host_header           = "example.internal.mydomain.com"
    priority               = 10
    target_group_port     = 8080
    target_group_protocol = "HTTP"
    health_check_path     = "/health"
    target_ips             = ["10.0.1.50"]
  }
}

shared_subnets = {
  "shared-app-subnet" = {
    cidr_block             = "10.0.5.0/27"
    availability_zone      = "eu-west-1a"
    principal_account_ids = ["234567890123"]
  }
}
